FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o backend/api-gateway/api-gateway ./backend/api-gateway/app/main.go

FROM alpine:latest
COPY --from=builder /app/backend /backend
WORKDIR /backend/api-gateway
EXPOSE 8080
CMD ["./api-gateway"]
