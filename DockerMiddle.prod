FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o service ./backend/services/middle/app/main.go

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/service ./service
COPY --from=builder /app/backend/services/middle/data /data
EXPOSE 8080
CMD ["./service"]
