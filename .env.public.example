# EXAMPLE .env.public file for development. 
# Copy this to .env.public in the project root.
# Ensure a symbolic link exists: frontend/.env -> ../.env.public
# OR
# Copy this to frontend/.env and fill in the values as needed.
# This file contains variables safely exposed to the Flutter frontend.

# --- SERVICE CONFIG ---
# For local dev: http://localhost:8080
# For Android Emulator: http://10.0.2.2:8080
BACKEND_URL=http://YOUR_IP_ADDRESS:8080


# --- SECRETS & API KEYS ---
MAPBOX_ACCESS_TOKEN=pk.EXAMPLE_MAPBOX_ACCESS_TOKEN